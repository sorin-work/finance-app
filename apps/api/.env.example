PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://finance:finance@localhost:5432/finance
# Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
SESSION_TTL_DAYS=7
# Set to true when serving over HTTPS
COOKIE_SECURE=false
# Create demo@example.com with a year of sample data on startup
SEED_DEMO=false
